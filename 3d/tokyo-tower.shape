// Tokyo Tower — 日本電波塔 (1958, Tachū Naitō)
// Scale: 1 unit = 10 metres. Y is up. Height 333 m.
// Main Deck 150 m, Top Deck 250 m, antenna ~79 m.

background 0.78 0.86 0.93

define orange (0.90 0.30 0.08)
define white (0.96 0.94 0.90)
define cream (0.93 0.89 0.80)
define glass (0.16 0.30 0.40)
define dark (0.22 0.20 0.19)
define concrete (0.72 0.71 0.67)
define grass (0.38 0.52 0.32)
define warn (0.85 0.08 0.06)

define paint(y) {
    if y < 3.45 {
        orange
    } else {
        if y < 5.45 {
            white
        } else {
            if y < 8.7 {
                orange
            } else {
                if y < 10.85 {
                    white
                } else {
                    if y < 14.65 {
                        orange
                    } else {
                        define k floor((y - 15.7) / 2.46)
                        if (k % 2) = 0 {
                            orange
                        } else {
                            white
                        }
                    }
                }
            }
        }
    }
}

define lowerSpan(y) {
    define t (min 1 (max 0 (y / 14.7)))
    define u (1 - t)
    1.02 + 3.55 * (0.80 * u + 0.20 * u * u)
}

define upperSpan(y) {
    define t (min 1 (max 0 ((y - 14.7) / 9.9)))
    1.02 * (1 - t) + 0.56 * t
}

define legW(y) {
    0.14 + 0.82 * (max 0 (1 - y / 14.7))
}

define strut(x0 y0 z0 x1 y1 z1 t col) {
    hull {
        color col
        cube {
            position x0 y0 z0
            size t
            color col
        }
        cube {
            position x1 y1 z1
            size t
            color col
        }
    }
}

define sxOf(c) {
    if (c = 0) or (c = 1) {
        1
    } else {
        -1
    }
}

define szOf(c) {
    if (c = 0) or (c = 3) {
        1
    } else {
        -1
    }
}

