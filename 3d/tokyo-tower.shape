// ------------------------------------------------
// Upper lattice shaft
// ------------------------------------------------
define nUp 8
define yUp0 16.22
define yUp1 24.55
define dyUp ((yUp1 - yUp0) / nUp)

for i in 0 to (nUp - 1) {
    define y0 (yUp0 + i * dyUp)
    define y1 (y0 + dyUp)
    define ym ((y0 + y1) / 2)
    define s0 upperSpan(y0)
    define s1 upperSpan(y1)
    define t (0.16 - 0.03 * (i / nUp))
    define tb (t * 0.55)
    define col paint(ym)

    for c in 0 to 3 {
        define sx sxOf(c)
        define sz szOf(c)
        strut((sx * s0) y0 (sz * s0) (sx * s1) y1 (sz * s1) t col)
    }
    for c in 0 to 3 {
        define c2 ((c + 1) % 4)
        define ax sxOf(c)
        define az szOf(c)
        define bx sxOf(c2)
        define bz szOf(c2)
        strut((ax * s0) y0 (az * s0) (bx * s0) y0 (bz * s0) tb col)
        strut((ax * s1) y1 (az * s1) (bx * s1) y1 (bz * s1) tb col)
        strut((ax * s0) y0 (az * s0) (bx * s1) y1 (bz * s1) tb col)
        strut((bx * s0) y0 (bz * s0) (ax * s1) y1 (az * s1) tb col)
        // mid-face vertical
        define mx (((ax + bx) * 0.5) * ((s0 + s1) * 0.5))
        define mz (((az + bz) * 0.5) * ((s0 + s1) * 0.5))
        strut(mx y0 mz mx y1 mz (tb * 0.9) col)
    }
}

