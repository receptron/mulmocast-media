// ------------------------------------------------
// Antenna / broadcasting mast
// ------------------------------------------------
define nAnt 6
define yAnt0 25.28
define yAnt1 32.15
define dyAnt ((yAnt1 - yAnt0) / nAnt)

define antSpan(y) {
    define t (min 1 (max 0 ((y - 25.28) / 6.9)))
    0.28 * (1 - t) + 0.07 * t
}

for i in 0 to (nAnt - 1) {
    define y0 (yAnt0 + i * dyAnt)
    define y1 (y0 + dyAnt)
    define ym ((y0 + y1) / 2)
    define s0 antSpan(y0)
    define s1 antSpan(y1)
    define t (0.10 - 0.03 * (i / nAnt))
    define tb (t * 0.55)
    define col paint(ym)
    for c in 0 to 3 {
        define sx sxOf(c)
        define sz szOf(c)
        strut((sx * s0) y0 (sz * s0) (sx * s1) y1 (sz * s1) t col)
    }
    for c in 0 to 3 {
        define c2 ((c + 1) % 4)
        define ax sxOf(c)
        define az szOf(c)
        define bx sxOf(c2)
        define bz szOf(c2)
        strut((ax * s0) y0 (az * s0) (bx * s0) y0 (bz * s0) tb col)
        strut((ax * s1) y1 (az * s1) (bx * s1) y1 (bz * s1) tb col)
        strut((ax * s0) y0 (az * s0) (bx * s1) y1 (bz * s1) tb col)
        strut((bx * s0) y0 (bz * s0) (ax * s1) y1 (az * s1) tb col)
    }
}

