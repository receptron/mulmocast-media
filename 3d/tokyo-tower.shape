    size 6.0 0.05 6.0
    color (0.78 0.77 0.73)
}

// Park trees, offset from the four legs
for k in 0 to 7 {
    define ta (k * (pi / 4) + pi / 8)
    define tr 7.6
    cylinder {
        position (tr * cos(ta)) 0.45 (tr * sin(ta))
        size 0.16 0.90 0.16
        color (0.38 0.24 0.12)
    }
    sphere {
        position (tr * cos(ta)) 1.15 (tr * sin(ta))
        size 0.85
        color (0.30 0.50 0.26)
    }
    sphere {
        position (tr * cos(ta) + 0.15) 1.45 (tr * sin(ta) + 0.08)
        size 0.55
        color (0.34 0.54 0.28)
    }
}

// Four concrete footings
for c in 0 to 3 {
    define sx sxOf(c)
    define sz szOf(c)
    define s0 lowerSpan(0.05)
    cube {
        position (sx * s0) 0.14 (sz * s0)
        size 1.40 0.34 1.40
        color concrete
    }
    cube {
        position (sx * s0) 0.40 (sz * s0)
        size 1.00 0.22 1.00
        color (0.60 0.58 0.54)
    }
}

