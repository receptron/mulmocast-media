// ------------------------------------------------
// Lower lattice — four 3-D legs + face X-bracing
// ------------------------------------------------
define nLow 9
define yLow0 0.22
define yLow1 14.55
define dyLow ((yLow1 - yLow0) / nLow)

for i in 0 to (nLow - 1) {
    define y0 (yLow0 + i * dyLow)
    define y1 (y0 + dyLow)
    define ym ((y0 + y1) / 2)
    define s0 lowerSpan(y0)
    define s1 lowerSpan(y1)
    define w0 legW(y0)
    define w1 legW(y1)
    define t (0.28 - 0.10 * (i / nLow))
    define tb (t * 0.55)
    define col paint(ym)

    for c in 0 to 3 {
        define sx sxOf(c)
        define sz szOf(c)
        // outer corner post
        strut((sx * s0) y0 (sz * s0) (sx * s1) y1 (sz * s1) t col)
        // inner corner post
        strut((sx * (s0 - w0)) y0 (sz * (s0 - w0)) (sx * (s1 - w1)) y1 (sz * (s1 - w1)) (t * 0.85) col)
        // leg side posts
        strut((sx * (s0 - w0)) y0 (sz * s0) (sx * (s1 - w1)) y1 (sz * s1) (t * 0.8) col)
        strut((sx * s0) y0 (sz * (s0 - w0)) (sx * s1) y1 (sz * (s1 - w1)) (t * 0.8) col)
        // internal X of the leg
        strut((sx * s0) y0 (sz * s0) (sx * (s1 - w1)) y1 (sz * (s1 - w1)) tb col)
        strut((sx * (s0 - w0)) y0 (sz * (s0 - w0)) (sx * s1) y1 (sz * s1) tb col)
        // horizontals around the leg at y1
        strut((sx * s1) y1 (sz * s1) (sx * (s1 - w1)) y1 (sz * s1) tb col)
        strut((sx * s1) y1 (sz * s1) (sx * s1) y1 (sz * (s1 - w1)) tb col)
        strut((sx * (s1 - w1)) y1 (sz * (s1 - w1)) (sx * (s1 - w1)) y1 (sz * s1) tb col)
        strut((sx * (s1 - w1)) y1 (sz * (s1 - w1)) (sx * s1) y1 (sz * (s1 - w1)) tb col)
    }

    // Face X-braces start above FootTown so the four legs stand open around it
    if i > 1 {
    for c in 0 to 3 {
        define c2 ((c + 1) % 4)
        define ax sxOf(c)
        define az szOf(c)
        define bx sxOf(c2)
        define bz szOf(c2)
        define ix0 (ax * (s0 - w0 * 0.15))
        define iz0 (az * (s0 - w0 * 0.15))
        define ix1 (ax * (s1 - w1 * 0.15))
        define iz1 (az * (s1 - w1 * 0.15))
        define jx0 (bx * (s0 - w0 * 0.15))
        define jz0 (bz * (s0 - w0 * 0.15))
        define jx1 (bx * (s1 - w1 * 0.15))
        define jz1 (bz * (s1 - w1 * 0.15))
        strut(ix0 y0 iz0 jx0 y0 jz0 tb col)
        strut(ix1 y1 iz1 jx1 y1 jz1 tb col)
        strut(ix0 y0 iz0 jx1 y1 jz1 tb col)
        strut(jx0 y0 jz0 ix1 y1 iz1 tb col)
    }
    }
}

