// Horizontal antenna elements
for k in 0 to 3 {
    define ya (26.4 + k * 1.35)
    define sa (antSpan(ya) + 0.18)
    cube {
        position 0 ya 0
        size (sa * 2.4) 0.04 0.04
        color paint(ya)
    }
    cube {
        position 0 ya 0
        size 0.04 0.04 (sa * 2.4)
        color paint(ya)
    }
}

